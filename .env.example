# ─────────────────────────────────────────────────────────────────
# Disastraaa — Environment Configuration Template
# Copy to .env.local and fill in values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────

# App base URL (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Map tile style URLs
# Defaults: CARTO Dark Matter / Positron — openly usable, no API key required.
# Swap for MapTiler/Stadia/custom styles in production.
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_LIGHT_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Optional: MapTiler API key for higher-quality vector tiles
# NEXT_PUBLIC_MAPTILER_KEY=
